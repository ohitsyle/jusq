# Copy to server/.env and fill in. Never commit the real file.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nucash?retryWrites=true&w=majority
PORT=3000
NODE_ENV=production
# 32+ random characters — the server refuses to start otherwise.
# Generate with: openssl rand -base64 48
JWT_SECRET=
EMAIL_USER=
EMAIL_PASSWORD=
